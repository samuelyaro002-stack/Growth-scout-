# ---------- Identity & attribution ----------
# Your hackathon attribution tag (shown on your Loops entry page). Goes on every tx the agent sends itself.
BUILDER_CODE=celo_16de1003cce6
# Optional. Leave empty if your tag was issued independently of any repo (yours was).
GITHUB_REPO=
REQUIRE_REPO_MATCH=0

# ---------- Wallet (host secret settings only, never commit) ----------
# ONE dedicated low-balance wallet: ERC-8004 owner, x402 payee, and the wallet that pays suppliers through buy.
# 64 hex characters, with or without the 0x prefix.
AGENT_PRIVATE_KEY=
# Set after `npm run register` prints the agent id.
AGENT_ID=

# ---------- Public URL of the deployed server (no trailing slash) ----------
PUBLIC_URL=

# ---------- x402 (what customers pay) ----------
# Create at https://x402.celo.org (connect the wallet, sign a free message). Required for settlement.
X402_API_KEY=
PRICE_PULSE_USD=0.02
PRICE_AUDIT_USD=0.10
# USA₮ is offered only when its EIP-712 name+version are set (run `npm run probe:usat` first).
USAT_EIP712_NAME=
USAT_EIP712_VERSION=

# ---------- buy (what the agent purchases) ----------
# Live buying is OFF until this is 1.
REPORT_PURCHASES_ENABLED=0
BUY_ALLOWED_SOURCES=x,reddit,youtube
BUY_ACCOUNT=agent
# Keep the buy home OUTSIDE the project. It stores only public account metadata, never the key.
BUY_HOME=/tmp/buy-home
BUY_MAX_X_USD=0.0075
BUY_MAX_REDDIT_USD=0.0075
BUY_MAX_YOUTUBE_USD=0.0075
# Hard safety rails (USD). One Audit needs about 0.0225 worst case.
MAX_SPEND_PER_REQUEST_USD=0.0225
DAILY_SPEND_CAP_USD=0.05
DATA_DIR=./data

# ---------- Dev switches ----------
# MOCK_BUY=1 serves fixture data instead of paying; DEV_NO_PAYWALL=1 additionally needs MOCK_BUY=1 and never runs in production.
MOCK_BUY=0
DEV_NO_PAYWALL=0
