# ---------- Identity & attribution ----------
# Your hackathon attribution tag (issued at enrollment). Goes on every tx the agent sends itself.
BUILDER_CODE=celo_16de1003cce6
# Optional. If your tag is derived from your repo, set owner/repo and run `npm run check-tag`.
# If the tag was issued independently (shown on your Loops entry page), leave this empty.
GITHUB_REPO=
# 1 = refuse to start/register when GITHUB_REPO does not derive BUILDER_CODE. Only set once check-tag says MATCH.
REQUIRE_REPO_MATCH=0

# ---------- Wallet (use Replit Secrets, never commit) ----------
# ONE dedicated low-balance wallet for everything: ERC-8004 owner, x402 payee, buy payer.
AGENT_PRIVATE_KEY=
# Set after `npm run register` prints the agent id.
AGENT_ID=

# ---------- Public URL of the deployed server ----------
PUBLIC_URL=https://your-app.replit.app

# ---------- x402 seller (what we sell) ----------
FACILITATOR_URL=https://api.x402.celo.org
# Create at https://x402.celo.org (connect wallet, sign message). Server-side secret.
X402_API_KEY=
PRICE_PULSE_USD=0.02
PRICE_AUDIT_USD=0.10
# USA₮ is accepted only when its EIP-712 name+version are set (run `npm run probe:usat` first).
USAT_EIP712_NAME=
USAT_EIP712_VERSION=

# ---------- buy (what we purchase) ----------
# buy runs headless on Replit via its file keystore (no OS keychain). Keep BUY_HOME OUTSIDE the project.
BUY_KEYSTORE_BACKEND=file
BUY_HOME=/home/runner/.buy-home
BUY_ACCOUNT=agent
# Leave BUY_BIN empty to use the locally installed ./node_modules/.bin/buy
#BUY_BIN=
BUY_PAY_TOKEN=USDC
# Hard safety rails on spending (USD)
MAX_SPEND_PER_REQUEST_USD=0.08
DAILY_SPEND_CAP_USD=2.00

# ---------- Dev switches ----------
# MOCK_BUY=1 serves fixture data instead of paying (local dev/tests only)
MOCK_BUY=0
# DEV_NO_PAYWALL=1 skips x402 (local dev/tests only, never in production)
DEV_NO_PAYWALL=0
PORT=3000
