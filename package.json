{
  "name": "growth-scout",
  "version": "0.1.0",
  "description": "GrowthScout: a growth-intelligence agent for Web3 projects. Buys social data with buy, sells Africa-focused growth reports over x402 on Celo.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check-tag": "tsx scripts/check-tag.ts",
    "register": "tsx scripts/register-8004.ts",
    "probe:usat": "tsx scripts/probe-usat.ts",
    "verify-tx": "tsx scripts/verify-tx.ts",
    "check-signer": "node src/runner.mjs --check-signer",
    "check-402": "tsx scripts/check-402.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@celo/buy": "0.8.2",
    "@celo/buy-keystore": "^0.8.2",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@x402/fetch": "^2.28.0",
    "typescript": "^7.0.2"
  }
}
